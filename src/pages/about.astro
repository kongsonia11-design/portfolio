---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Sonia Kong">
  <div class="about-page">
    <p class="section-label">About</p>
    <div class="about-page__grid">
      <div>
        <div class="about-page__photo">
          <!-- Save your photo as public/images/sonia.jpg then uncomment below -->
          <!-- <img src="/images/sonia.jpg" alt="Sonia Kong" /> -->
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--cream-dark);font-family:var(--font-display);font-size:5rem;color:var(--cream-border);">✦</div>
        </div>
      </div>
      <div class="about-page__text">
        <h1>Sonia<br/><em>Kong</em></h1>
        <p>
          I'm a product designer and artist driven by a simple belief:
          design should make you feel something. My work sits at the
          intersection of function and play — objects, experiences, and
          visuals that invite you to look twice, touch, or smile.
        </p>
        <p>
          Whether I'm working on a brand identity, a physical product,
          or an art piece, I'm always asking: <em>what does this make
          you think? What does this make you feel?</em>
        </p>
        <h3 style="margin-top:3rem;margin-bottom:0.5rem;font-size:1rem;letter-spacing:0.1em;text-transform:uppercase;font-family:var(--font-body);font-weight:500;color:var(--ink-light);">Disciplines</h3>
        <ul class="skills-list">
          <li>Product Design</li>
          <li>Interactive Design</li>
          <li>Brand Identity</li>
          <li>Fine Art</li>
        </ul>
        <div style="margin-top:3rem;display:flex;flex-direction:column;gap:1.25rem;">
          <a href="mailto:kongsonia11@gmail.com" style="display:inline-flex;align-items:center;gap:0.75rem;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mid);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink-mid)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <polyline points="2,4 12,13 22,4"/>
            </svg>
            kongsonia11@gmail.com
          </a>
          <a href="https://www.instagram.com/soniakong.design" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:0.75rem;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mid);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink-mid)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
            @soniakong.design
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
