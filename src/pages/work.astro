---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="Work — Sonia Kong">
  <div style="padding-top: calc(72px + 4rem); padding-bottom: 6rem;">
    <div class="container" style="margin-bottom: 3rem;">
      <p class="section-label">All Projects</p>
      <h1 style="font-family: var(--font-display); font-weight: 400; font-size: clamp(3rem, 7vw, 5.5rem); line-height: 1.05;">
        Selected<br/><em>Work</em>
      </h1>
    </div>
    {sorted.length > 0 ? (
      <div class="container">
        <div class="projects-grid">
          {sorted.map(project => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              image={project.data.image}
              href={`/work/${project.slug}`}
            />
          ))}
        </div>
      </div>
    ) : (
      <div class="container">
        <p style="color: var(--ink-light); font-style: italic;">Projects coming soon.</p>
      </div>
    )}
  </div>
  <!-- Hover image preview -->
  <div id="preview">
    <img id="preview-img" src="" alt="" />
  </div>
</BaseLayout>

<style>
#preview {
  position: fixed;
  width: 220px;
  aspect-ratio: 3/4;
  pointer-events: none;
  z-index: 500;
  opacity: 0;
  transform: scale(0.92);
  transition: opacity 0.3s ease, transform 0.3s ease;
  overflow: hidden;
  border-radius: 2px;
}
#preview.visible {
  opacity: 1;
  transform: scale(1);
}
#preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  max-width: none !important;
}
</style>

<script>
  const preview = document.getElementById('preview')!;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const cards = document.querySelectorAll('.project-card');

  document.addEventListener('mousemove', e => {
    preview.style.left = (e.clientX + 24) + 'px';
    preview.style.top  = (e.clientY - 60) + 'px';
  });

  cards.forEach(card => {
    const img = card.querySelector('img');
    if (!img) return;
    card.addEventListener('mouseenter', () => {
      previewImg.src = img.src;
      preview.classList.add('visible');
    });
    card.addEventListener('mouseleave', () => {
      preview.classList.remove('visible');
    });
  });
</script>
